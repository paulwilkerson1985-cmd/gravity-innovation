{
  "name": "orbkin",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "sim": "tsx tools/sim.ts",
    "server": "tsx server/index.ts",
    "font": "tsx tools/pixelfont/build.ts",
    "smoke": "playwright test",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build && npm run smoke"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "1.56.1",
    "@types/node": "^22.20.5",
    "@types/opentype.js": "^1.3.10",
    "@types/three": "^0.180.0",
    "@types/ws": "^8.18.1",
    "eslint": "^9.39.5",
    "opentype.js": "^1.3.4",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^7.3.7",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "three": "^0.180.0",
    "ws": "^8.18.3"
  }
}
